import discord
import os
import requests
# Import các hàm xử lý từ 2 file vệ tinh (sẽ viết ở bước sau)
from database import get_or_create_user, get_next_sentence, update_user_progress, save_failed_word
from ai_brain import analyze_audio_with_whisper, send_new_word_tutorial

# 1. Cấu hình Intents bắt buộc của Discord
intents = discord.Intents.default()
intents.message_content = True  # Cho phép Bot đọc nội dung tin nhắn text
client = discord.Client(intents=intents)

# 2. Bộ nhớ đệm lưu trạng thái học trong ngày của User
# Cấu trúc: { user_id: { "round": 1, "sentence": "...", "fail_count": 0 } }
user_sessions = {}

@client.event
async def on_ready():
    print(f"🤖 Bot Discord đã trực tuyến với tên: {client.user}")
    print("--------------------------------------------------")

@client.event
async def on_message(message):
    # Không xử lý tin nhắn của chính Bot
    if message.author == client.user:
        return

    user_id = str(message.author.id)
    user_name = message.author.name

    # ==========================================
    # LỆNH VÀO HỌC: !daily
    # ==========================================
    if message.content == "!daily":
        if user_id in user_sessions:
            await message.reply("🔄 Bạn đang trong trận đấu rồi! Hãy hoàn thành câu hiện tại nhé.")
            return

        await message.channel.send("🔄 Giáo viên AI đang mở học bạ điện tử...")
        
        # Lấy thông tin user và chuỗi ngày học từ Database
        user_data = get_or_create_user(user_id, user_name)
        streak = user_data["streak"]
        
        # Lấy câu hỏi phù hợp theo thuật toán Spaced Repetition (Hộp từ vựng)
        next_task = get_next_sentence(user_id)
        
        # Khởi tạo Session học cho ngày hôm nay
        user_sessions[user_id] = {
            "round": 1,
            "sentence": next_task["sentence"],
            "new_word": next_task["new_word"], # Từ mới hoặc từ từng sai nặng cần lưu ý
            "fail_count": 0
        }
        
        await message.channel.send(f"🔥 **Chuỗi học tập hằng ngày:** `{streak} ngày liên tục`. Đừng để tắt lửa!")
        
        # Nếu câu này có chứa từ mới/từ khó -> Kích hoạt chế độ Tiền giáo dục (Đọc mẫu + giải thích)
        if next_task["new_word"]:
            await send_new_word_tutorial(message.channel, next_task["sentence"], next_task["new_word"])
        else:
            await message.reply(
                f"🎯 **HIỆP 1/3 - Hãy đọc to câu sau bằng tin nhắn thoại (Voice):**\n"
                f"👉 **`{next_task['sentence']}`**"
            )
        return

    # ==========================================
    # XỬ LÝ KHI USER GỬI FILE VOICE ĐỂ CHẤM ĐIỂM
    # ==========================================
    # Điều kiện: User đang trong Session học và có gửi file đính kèm (Attachment)
    if user_id in user_sessions and message.attachments:
        session = user_sessions[user_id]
        attachment = message.attachments[0]
        
        # Kiểm tra xem có phải file âm thanh không (Discord Voice thường có đuôi .ogg hoặc .wav)
        if any(attachment.filename.endswith(ext) for ext in ['.ogg', '.wav', '.mp3', '.m4a']):
            await message.channel.send("👂 AI đang nghe và phân tích phát âm của bạn...")
            
            # Tải file âm thanh từ Discord về máy local
            temp_audio_path = f"temp_{user_id}_{attachment.filename}"
            with open(temp_audio_path, "wb") as f:
                f.write(requests.get(attachment.url).content)
                
            # Gửi file qua AI Brain (Whisper + difflib) để chấm điểm và lấy bản đồ lỗi ANSI
            score, ansi_feedback, error_details = analyze_audio_with_whisper(temp_audio_path, session["sentence"])
            
            # Xóa file tạm sau khi xử lý xong
            if os.path.exists(temp_audio_path):
                os.remove(temp_audio_path)
                
            # IN KẾT QUẢ TRỰC QUAN LÊN DISCORD
            progress_bar = "🟩" * session["round"] + "⬜" * (3 - session["round"])
            await message.reply(
                f"📊 **Tiến độ:** [{progress_bar}] Hiệp {session['round']}/3\n"
                f"🎯 **Điểm số:** `{score}/100`"
            )
            
            # Gửi bản đồ chữ màu ANSI (Bắt buộc bọc trong block ```ansi)
            await message.channel.send(f"📝 **Bản đồ phát âm:**\n```ansi\n{ansi_feedback}\n```")
            
            if error_details:
                await message.channel.send(f"🔍 **Chi tiết lỗi:**\n{error_details}")

            # LOGIC ĐIỀU HƯỚNG HIỆP ĐẤU (CHỐNG NẢN)
            if score >= 80:
                # ĐẠT CHUẨN -> LÊN LỚP
                session["round"] += 1
                session["fail_count"] = 0 # Reset số lần sai
                
                if session["round"] > 3:
                    # HOÀN THÀNH 3 CÂU CỦA NGÀY
                    new_streak = update_user_progress(user_id, status="completed")
                    await message.channel.send(
                        f"🏆 **XUẤT SẮC! BẠN ĐÃ HOÀN THÀNH CHỈ TIÊU NGÀY!** 🏆\n"
                        f"🔥 Chuỗi của bạn tăng lên: **{new_streak} ngày**. Hãy nghỉ ngơi và quay lại vào ngày mai!"
                    )
                    del user_sessions[user_id] # Đóng session ngày
                else:
                    # QUA HIỆP TIẾP THEO
                    next_task = get_next_sentence(user_id)
                    session["sentence"] = next_task["sentence"]
                    session["new_word"] = next_task["new_word"]
                    
                    if next_task["new_word"]:
                        await send_new_word_tutorial(message.channel, next_task["sentence"], next_task["new_word"])
                    else:
                        await message.channel.send(
                            f"💪 Tiến lên! **HIỆP {session['round']}/3:**\n"
                            f"👉 **`{session['sentence']}`**"
                        )
            else:
                # CHƯA ĐẠT CHUẨN (<80 điểm) -> TĂNG BIẾN ĐẾM THẤT BẠI
                session["fail_count"] += 1
                
                if session["fail_count"] >= 3:
                    # SAI QUÁ 3 LẦN -> KÍCH HOẠT ĐẶC CÁCH CHO QUA (CỨU TRỢ TÂM LÝ)
                    if session["new_word"]:
                        save_failed_word(user_id, session["new_word"]) # Lưu vào sổ đen phục thù
                    
                    session["round"] += 1
                    session["fail_count"] = 0
                    
                    await message.channel.send(
                        f"🤝 **Thầy AI can thiệp:** Câu này có vẻ hơi quá sức với cơ miệng của bạn hôm nay. "
                        f"Thầy đã lưu nó vào *'Danh sách phục thù'* để ngày mai luyện lại. Đừng nản lòng nhé!\n"
                    )
                    
                    if session["round"] > 3:
                        new_streak = update_user_progress(user_id, status="completed")
                        await message.channel.send(f"🏆 Bạn vẫn được tính là Hoàn thành nhiệm vụ ngày để giữ chuỗi! 🔥 Chuỗi: `{new_streak} ngày`.")
                        del user_sessions[user_id]
                    else:
                        next_task = get_next_sentence(user_id)
                        session["sentence"] = next_task["sentence"]
                        session["new_word"] = next_task["new_word"]
                        await message.channel.send(f"⏭️ Hãy tạm gác nó lại và bước sang **HIỆP {session['round']}/3** với thử thách mới:")
                        await message.channel.send(f"👉 **`{session['sentence']}`**")
                else:
                    # SAI DƯỚI 3 LẦN -> ÉP THỬ LẠI
                    await message.reply(f"❌ Điểm chưa đạt chuẩn (>80). Đừng nản, uốn lưỡi kỹ hơn và **thử lại chính câu này** xem nào! (Lần thử {session['fail_count']}/3)")

# Điền Token của bạn ở trang Discord Developer Portal vào đây
client.run("DISCORD_BOT_TOKEN_CỦA_BẠN")
