      "order": 1,
      "title": "Project Overview",
      "description": "Start with the README to understand the bot's purpose: a Discord-based English pronunciation coach using spaced repetition, smart engine routing, and color-coded ANSI feedback.",
      "nodeIds": [
        "document:README.md"
      ]
    },
    {
      "order": 2,
      "title": "Application Entry Point",
      "description": "app.py is the Discord event loop — it handles commands (!daily, !more, !skip, !stop, !stats), manages session state (rounds, fail counts, modes), and orchestrates the learning flow by calling ai_brain and database modules.",
      "nodeIds": [
        "file:app.py"
      ]
    },
    {
      "order": 3,
      "title": "AI Brain — Scoring Engine",
      "description": "ai_brain.py contains the core pronunciation analysis: Whisper/Azure speech-to-text, smart engine routing via Ollama difficulty assessment, phoneme similarity scoring with IPA, error type classification, and Edge-TTS audio generation for pre-teaching.",
      "nodeIds": [
        "file:ai_brain.py"
      ]
    },
    {
      "order": 4,
      "title": "Database — Spaced Repetition & Progress",
      "description": "database.py manages SQLite persistence: Leitner box scheduling (Box 1/2/3), streak tracking, score history, error pattern detection, auto-level adjustment, and the 'revenge list' of failed words.",
      "nodeIds": [
        "file:database.py"
      ]
    },
